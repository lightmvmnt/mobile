{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@store/*": ["src/store/*"],
      "@modules/*": ["src/modules/*"],
      "@components/*": ["src/globalComponents/*"],
      "@utils/*": ["src/utils/*"],
      "@services/*": ["src/services/*"],
      "@constants/*": ["src/constants/*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  "extends": "@react-native/typescript-config/tsconfig.json"
}
