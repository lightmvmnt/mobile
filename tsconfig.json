{
   "extends": "@tsconfig/react-native/tsconfig.json",
    "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "*": ["src/*"],
      "@assets/*": ["src/assets/*"],
      "@constants/*": ["src/constants/*"],
      "@modules/*": ["src/modules/*"],
      "@services/*": ["src/services/*"],
      "@store/*": ["src/store/*"],
      "@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@globalComponents/*": ["src/globalComponents/*"]
    }
  }
}
